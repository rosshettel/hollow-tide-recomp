+void gui_saveScreenshot(const std::string& path)
+{
+	gui_runOnUiThread([path]() {
+		std::vector<u8> data;
+		getScreenshot(data, 640);
+		FILE *f = data.empty() ? nullptr : nowide::fopen(path.c_str(), "wb");
+		if (f == nullptr) {
+			WARN_LOG(COMMON, "screenshot %s not written", path.c_str());
+			return;
+		}
+		std::fwrite(&data[0], data.size(), 1, f);
+		std::fclose(f);
+	});
+}
